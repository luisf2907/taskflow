# ═══════════════════════════════════════════════════════════════════════
# Taskflow self-hosted — perfil FULL (paridade SaaS)
# ═══════════════════════════════════════════════════════════════════════
# Setup: node scripts/setup-env.mjs full

# ───── Secrets (substituidos pelo setup-env.mjs) ─────
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
NEXT_PUBLIC_SUPABASE_ANON_KEY=changeme-anon-jwt
SUPABASE_SERVICE_ROLE_KEY=changeme-service-role-jwt
POSTGRES_PASSWORD=changeme-strong-random
ENCRYPTION_KEY=changeme-64-hex-chars

# ───── Endpoints ─────
# ATENCAO: estes valores sao resolvidos PELO NAVEGADOR, nao pelos
# containers. "localhost" so funciona quando voce acessa o app da mesma
# maquina que roda o Docker.
#
# Acessando de outra maquina — rede local, Tailscale, VPN, dominio — troque
# localhost pelo MESMO host que voce digita na barra de enderecos. Se o app
# abre em http://servidor:3000, aqui vai http://servidor:8000. Misturar
# hostname e IP quebra o cookie de sessao, que e por origem.
#
# Sintoma de estar errado:
#   POST http://localhost:8000/auth/v1/signup net::ERR_CONNECTION_REFUSED
# O navegador tentou falar consigo mesmo em vez de com o servidor.
#
# As duas sao NEXT_PUBLIC_*, ou seja, embutidas no bundle em tempo de BUILD.
# Mudar exige rebuild da imagem do app, nao basta restart:
#   docker compose -f docker/docker-compose.full.yml --env-file .env.local up -d --build app
#
# NEXT_PUBLIC_SITE_URL alimenta tambem GOTRUE_SITE_URL e
# GOTRUE_URI_ALLOW_LIST, entao o gotrue precisa ser recriado junto.
#
# O lado servidor NAO usa estas variaveis: ele fala com http://nginx:8000
# pela rede interna do Docker (SUPABASE_INTERNAL_URL, fixo no compose).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════
# AUTH
# ═══════════════════════════════════════════════════════════════════════
AUTH_MODE=standard
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_MAILER_AUTOCONFIRM=false
# SOLO_USER_EMAIL=admin@taskflow.local

# GitHub OAuth no login (requer GoTrue com GOTRUE_EXTERNAL_GITHUB_*)
# NEXT_PUBLIC_GITHUB_OAUTH=true

# ═══════════════════════════════════════════════════════════════════════
# STORAGE (MinIO S3)
# ═══════════════════════════════════════════════════════════════════════
STORAGE_DRIVER=s3-compat
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin
STORAGE_S3_BUCKET_PREFIX=taskflow-
# Idem: resolvido pelo NAVEGADOR, que baixa anexos direto do MinIO.
# Acessando de outra maquina, troque localhost pelo mesmo host das
# variaveis acima. Note que o compose so publica a porta 9001 (console) —
# para o download direto funcionar de fora, o servico minio precisa
# publicar tambem a 9000.
STORAGE_S3_PUBLIC_ENDPOINT=http://localhost:9000
# STORAGE_LOCAL_PATH=/app/storage

# ═══════════════════════════════════════════════════════════════════════
# REALTIME
# ═══════════════════════════════════════════════════════════════════════
REALTIME_DRIVER=pg-notify-sse
NEXT_PUBLIC_REALTIME_DRIVER=pg-notify-sse

# ═══════════════════════════════════════════════════════════════════════
# EMAIL
# ═══════════════════════════════════════════════════════════════════════
EMAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
# RESEND_API_KEY=re_xxx

# ═══════════════════════════════════════════════════════════════════════
# LLM (IA)
# ═══════════════════════════════════════════════════════════════════════
# LLM_DRIVER: gemini | ollama | openai-compat | disabled
#   (anthropic esta no enum mas ainda nao tem driver)
#
# NEXT_PUBLIC_AI_ENABLED=true e o que faz a UI de IA APARECER. E separada
# de proposito: o navegador nao pode ver LLM_DRIVER nem chave nenhuma.
# Sendo NEXT_PUBLIC_*, exige rebuild do app — nao basta recriar.
LLM_DRIVER=disabled
# NEXT_PUBLIC_AI_ENABLED=true

# ───── Gemini ─────
# GEMINI_API_KEY=xxx
# LLM_MODEL=gemini-flash-latest        # opcional; este e o default

# ───── Ollama ─────
# LLM_DRIVER=ollama
# LLM_MODEL=llama3.1                   # opcional; este e o default
#
# ONDE O OLLAMA RODA muda a URL, porque quem resolve o nome e o CONTAINER
# do app, nao a sua maquina:
#
#   no HOST (ollama serve)   LLM_BASE_URL=http://host.docker.internal:11434
#   em outro container       LLM_BASE_URL=http://ollama:11434
#   em outra maquina         LLM_BASE_URL=http://192.168.x.x:11434
#
# "localhost" aqui seria o proprio container do app — nunca funciona.
# O /v1 e opcional: com ou sem, o driver normaliza.
#
# Se o Ollama roda no host, ele precisa escutar fora do loopback:
#   OLLAMA_HOST=0.0.0.0 ollama serve
#
# Function calling e obrigatorio pro assistente (rota ai/ask). Modelos sem
# suporte respondem sem consultar dado nenhum. llama3.1, qwen2.5 e
# mistral-nemo suportam; muitos modelos pequenos nao.

# ───── Qualquer endpoint OpenAI-compativel ─────
# vLLM, LM Studio, llama.cpp server, Groq, OpenRouter, OpenAI
# LLM_DRIVER=openai-compat
# LLM_BASE_URL=https://api.exemplo.com/v1
# LLM_API_KEY=
# LLM_MODEL=

# ═══════════════════════════════════════════════════════════════════════
# VOICE
# ═══════════════════════════════════════════════════════════════════════
VOICE_DRIVER=disabled
# VOICE_DRIVER=fastapi
# VOICE_WORKER_URL=http://voice-worker:8080
# VOICE_WORKER_API_KEY=changeme
# VOICE_WEBHOOK_SECRET=changeme-min-32-chars
# WHISPER_MODEL=large-v3
# HF_TOKEN=hf_xxx

# ═══════════════════════════════════════════════════════════════════════
# VCS (GitHub / Gitea)
# ═══════════════════════════════════════════════════════════════════════
VCS_DRIVER=github
VCS_TOKEN_MODE=pat
# VCS_API_URL=
# VCS_INSTANCE_PAT=ghp_xxx

# ═══════════════════════════════════════════════════════════════════════
# OBSERVABILITY (GlitchTip)
# ═══════════════════════════════════════════════════════════════════════
# Dashboard: http://localhost:8800 — crie org + projeto, copie DSN
OBS_DRIVER=glitchtip
NEXT_PUBLIC_SENTRY_DSN=
GLITCHTIP_SECRET_KEY=changeme-glitchtip-secret
GLITCHTIP_DOMAIN=http://localhost:8800

# ═══════════════════════════════════════════════════════════════════════
# REDIS
# ═══════════════════════════════════════════════════════════════════════
# Ja configurado no compose full (redis://redis:6379)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
